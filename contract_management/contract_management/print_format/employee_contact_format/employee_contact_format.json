 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>Employment Contract</title>\r\n  <style>\r\n    body { font-family: Arial, sans-serif; margin: 40px; font-size: 14px; color: #222; }\r\n    h1 { text-align: center; font-size: 20px; margin-bottom: 30px; }\r\n    h2 { font-size: 16px; border-bottom: 1px solid #ccc; margin-top: 30px; }\r\n    .section { margin-bottom: 20px; }\r\n    .label { font-weight: bold; display: inline-block; width: 180px; vertical-align: top; }\r\n    .value { display: inline-block; max-width: 70%; }\r\n    .signature { margin-top: 40px; }\r\n    form label { display: block; margin-top: 10px; font-weight: bold; }\r\n    form input { display: block; margin-bottom: 10px; width: 300px; padding: 5px; }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n<h1>Employment Contract</h1>\r\n\r\n<h2>Employer Information</h2>\r\n<div><span class=\"label\">Company Name:</span><span class=\"value\">{{ doc.company_name }}</span></div>\r\n<div><span class=\"label\">Company Address:</span><span class=\"value\">{{ doc.company_address }}</span></div>\r\n<div><span class=\"label\">Phone:</span><span class=\"value\">{{ doc.company_phone }}</span></div>\r\n\r\n<!-- Replaced Employee Information section with a form -->\r\n<form>\r\n\r\n  <div class=\"section\" id=\"employee_information_section\">\r\n    <label for=\"verification_id\">Verification ID:</label>\r\n    <input type=\"text\" id=\"verification_id\" name=\"verification_id\">\r\n    \r\n    <label for=\"first_name\">First Name:</label>\r\n    <input type=\"text\" id=\"first_name\" name=\"first_name\">\r\n    \r\n    <label for=\"middle_name\">Middle Name:</label>\r\n    <input type=\"text\" id=\"middle_name\" name=\"middle_name\">\r\n    \r\n    <label for=\"last_name\">Last Name:</label>\r\n    <input type=\"text\" id=\"last_name\" name=\"last_name\">\r\n    \r\n    <label for=\"gender\">Gender:</label>\r\n    <input type=\"text\" id=\"gender\" name=\"gender\">\r\n    \r\n    <label for=\"date_of_birth\">Date of Birth:</label>\r\n    <input type=\"date\" id=\"date_of_birth\" name=\"date_of_birth\">\r\n    \r\n    <label for=\"country_of_birth\">Country of Birth:</label>\r\n    <input type=\"text\" id=\"country_of_birth\" name=\"country_of_birth\">\r\n    \r\n    <label for=\"citizenship\">Citizenship:</label>\r\n    <input type=\"text\" id=\"citizenship\" name=\"citizenship\">\r\n    \r\n    <label for=\"applicant_contact_number\">Applicant Contact Number:</label>\r\n    <input type=\"tel\" id=\"applicant_contact_number\" name=\"applicant_contact_number\">\r\n    \r\n    <label for=\"applicant_email\">Applicant Email:</label>\r\n    <input type=\"email\" id=\"applicant_email\" name=\"applicant_email\">\r\n  </div>\r\n  \r\n  <div class=\"section\" id=\"what_is_your_current_address_section\">\r\n    <label for=\"applicant_address\">Applicant Address:</label>\r\n    <input type=\"text\" id=\"applicant_address\" name=\"applicant_address\">\r\n    \r\n    <label for=\"address2\">Address 2:</label>\r\n    <input type=\"text\" id=\"address2\" name=\"address2\">\r\n    \r\n    <label for=\"zip__postal_code\">ZIP/Postcode:</label>\r\n    <input type=\"text\" id=\"zip__postal_code\" name=\"zip__postal_code\">\r\n    \r\n    <label for=\"city_emp\">City:</label>\r\n    <input type=\"text\" id=\"city_emp\" name=\"city_emp\">\r\n    \r\n    <label for=\"state__province\">State/Province:</label>\r\n    <input type=\"text\" id=\"state__province\" name=\"state__province\">\r\n    \r\n    <label for=\"country_emp\">Country:</label>\r\n    <input type=\"text\" id=\"country_emp\" name=\"country_emp\">\r\n  </div>\r\n</form>\r\n\r\n<h2>Employment Details</h2>\r\n<div><span class=\"label\">Date of Joining:</span><span class=\"value\">{{ doc.date_of_joining }}</span></div>\r\n<div><span class=\"label\">Contract Duration:</span><span class=\"value\">{{ doc.contract_duration }}</span></div>\r\n<div><span class=\"label\">Salary:</span><span class=\"value\">{{ doc.salary }}</span></div>\r\n\r\n<h2>Job Responsibilities</h2>\r\n<div><span class=\"label\">Designation:</span><span class=\"value\">{{ doc.designation }}</span></div>\r\n<div><span class=\"label\">Job Description:</span><span class=\"value\">{{ doc.job_description }}</span></div>\r\n\r\n<h2>Bank Information</h2>\r\n<div><span class=\"label\">Bank Name:</span><span class=\"value\">{{ doc.bank_name }}</span></div>\r\n<div><span class=\"label\">Account Number:</span><span class=\"value\">{{ doc.account_number }}</span></div>\r\n<div><span class=\"label\">IBAN:</span><span class=\"value\">{{ doc.iban }}</span></div>\r\n\r\n<h2>Workplace</h2>\r\n<div><span class=\"label\">Work Location:</span><span class=\"value\">{{ doc.work_location }}</span></div>\r\n<div><span class=\"label\">Department:</span><span class=\"value\">{{ doc.department }}</span></div>\r\n\r\n<h2>Work Conditions</h2>\r\n<div><span class=\"label\">Working Hours:</span><span class=\"value\">{{ doc.working_hours }}</span></div>\r\n<div><span class=\"label\">Leave Policy:</span><span class=\"value\">{{ doc.leave_policy }}</span></div>\r\n\r\n<h2>Legal & Insurance</h2>\r\n<div><span class=\"label\">Health Insurance:</span><span class=\"value\">{{ doc.health_insurance }}</span></div>\r\n<div><span class=\"label\">Labor Law Reference:</span><span class=\"value\">{{ doc.labor_law }}</span></div>\r\n\r\n<h2>Signatures</h2>\r\n<div><span class=\"label\">Place:</span><span class=\"value\">{{ doc.contract_place }}</span></div>\r\n<div><span class=\"label\">Date:</span><span class=\"value\">{{ doc.contract_date }}</span></div>\r\n<br><br>\r\n<div class=\"signature\">\r\n  <span class=\"label\">Employer:</span> {{ doc.company_name }}<br>\r\n  <span class=\"label\">Employee:</span> {{ doc.employee_name }}\r\n</div>\r\n\r\n</body>\r\n</html>\r\n",
