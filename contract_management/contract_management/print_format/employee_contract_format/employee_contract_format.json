{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-05-13 13:08:19.342646",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Employee Contract",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"utf-8\">\r\n    <title>Employee Contract - {{ doc.name }}</title>\r\n    <style>\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            line-height: 1.6;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        .header {\r\n            text-align: center;\r\n            margin-bottom: 30px;\r\n        }\r\n        .header h1 {\r\n            margin-bottom: 5px;\r\n        }\r\n        .section {\r\n            margin-bottom: 20px;\r\n            page-break-inside: avoid;\r\n        }\r\n        .section-title {\r\n            font-weight: bold;\r\n            border-bottom: 1px solid #000;\r\n            margin-bottom: 10px;\r\n            padding-bottom: 5px;\r\n        }\r\n        .compact-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        .section table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        .section table td {\r\n            padding: 5px 8px;\r\n            vertical-align: top;\r\n            line-height: 1.3;\r\n        }\r\n        .signature-area {\r\n            margin-top: 50px;\r\n        }\r\n        .signature-line {\r\n            border-top: 1px solid #000;\r\n            width: 250px;\r\n            margin-top: 40px;\r\n        }\r\n        .checkbox-label {\r\n            display: flex;\r\n            align-items: flex-start;\r\n            margin-bottom: 10px;\r\n        }\r\n        .checkbox-label input[type=\"checkbox\"] {\r\n            margin-right: 10px;\r\n            width: 18px;\r\n            height: 18px;\r\n            accent-color: #ffffff;\r\n        }\r\n        ul.rule-list {\r\n            list-style: none;\r\n            padding-left: 0;\r\n        }\r\n        ul.rule-list li {\r\n            margin-bottom: 10px;\r\n        }\r\n        .rule-content {\r\n            display: none;\r\n        }\r\n        .rule-content.active {\r\n            display: inline;\r\n        }\r\n        .checkbox-list {\r\n            list-style: none;\r\n            padding-left: 0;\r\n            margin: 0 0 1em 0;\r\n        }\r\n        .checkbox-li {\r\n            position: relative;\r\n            padding-left: 28px;\r\n            margin-bottom: 8px;\r\n            user-select: none;\r\n        }\r\n        .checkbox-li::before {\r\n            content: \"\";\r\n            position: absolute;\r\n            left: 0;\r\n            top: 3px;\r\n            width: 18px;\r\n            height: 18px;\r\n            border: 2px solid #007BFF;\r\n            border-radius: 4px;\r\n            background-color: #fff;\r\n            box-sizing: border-box;\r\n        }\r\n        .checkbox-li.checked::after {\r\n            content: \"\u2714\";\r\n            position: absolute;\r\n            left: 3px;\r\n            top: 1px;\r\n            font-size: 16px;\r\n            color: #007BFF;\r\n            font-weight: bold;\r\n            user-select: none;\r\n        }\r\n        .section {\r\n            display: block !important;\r\n        }\r\n        .lsn-wrapper {\r\n            background: white;\r\n            width: 100%;\r\n            height: 100%;\r\n            padding-left: 30px;\r\n            padding-right: 30px;\r\n            margin: auto;\r\n            border: 1px solid #ddd;\r\n            box-shadow: 0 0 10px rgba(0,0,0,0.1);\r\n            font-family: Arial, sans-serif;\r\n            color: #333;\r\n        }\r\n        .lsn-title {\r\n            font-size: 24px;\r\n            margin-bottom: 20px;\r\n        }\r\n        .grid-wrapper {\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 20px;\r\n            align-items: stretch;\r\n        }\r\n        .lsn-metadata,\r\n        .lsn-status {\r\n         height: 100%;\r\n        }\r\n        .lsn-metadata {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            background-color: #f4f4f4;\r\n            padding: 15px;\r\n            border: 1px solid #ccc;\r\n            border-radius: 5px;\r\n            margin-bottom: 10px;\r\n        }\r\n        .lsn-status {\r\n            background-color: #e6f8ed;\r\n            border: 1px solid #a0d8b3;\r\n            border-radius: 5px;\r\n            padding: 15px;\r\n            color: #2c7a4b;\r\n            font-weight: bold;\r\n        }\r\n        .lsn-trail {\r\n            margin-top: 30px;\r\n        }\r\n        .lsn-event {\r\n            margin-bottom: 20px;\r\n        }\r\n        .lsn-verified {\r\n            color: #2c7a4b;\r\n            font-weight: bold;\r\n        }\r\n        .lsn-ip {\r\n            font-family: monospace;\r\n            font-size: 13px;\r\n        }\r\n        .lsn-time {\r\n            font-weight: bold;\r\n        }\r\n        .lsn-generated {\r\n            margin-top: 20px;\r\n            font-size: 12px;\r\n            color: #777;\r\n        }\r\n        @media print {\r\n            .lsn-wrapper {\r\n                page-break-before: always;\r\n                margin-top: 0;\r\n            }\r\n            .lsn-trail {\r\n                page-break-before: auto;\r\n                margin-top: 30px;\r\n            }\r\n        }\r\n        .conduct-section {\r\n            margin-bottom: 20px;\r\n        }\r\n        .id-image {\r\n            max-width: 300px;\r\n            border: 1px solid #ccc;\r\n            padding: 5px;\r\n            margin-top: 5px;\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n    <div class=\"header\">\r\n        <h1>EMPLOYEE CONTRACT</h1>\r\n        <p>Contract Number: {{ doc.name }}</p>\r\n    </div>\r\n\r\n    <div class=\"section\" style=\"margin: 0; padding: 0;\">\r\n        <div class=\"section-title\">1. EMPLOYER INFORMATION</div>\r\n        <table style=\"width: 100%; border-collapse: collapse; border-spacing: 0;\">\r\n            <tr style=\"margin: 0; padding: 0;\">\r\n                <td style=\"width:50%; padding: 2px 8px; vertical-align: top; line-height: 1;\">\r\n                    <strong>Employer:</strong> {{ doc.employer }}<br><br>\r\n                    <strong>Address:</strong> {{ doc.address }}<br><br>\r\n                    <strong>Postcode:</strong> {{ (doc.postcode|string)[:6] }}<br><br>\r\n                    <strong>City:</strong> {{ doc.city }}<br><br>\r\n                    <strong>Country:</strong> {{ doc.country }}<br><br>\r\n                </td>\r\n                <td style=\"width:50%; padding: 2px 8px; vertical-align: top; line-height: 1;\">\r\n                    <strong>Mobile Phone:</strong> {{ doc.mobile_phone_number }}<br><br>\r\n                    <strong>Organization Number:</strong> {{ doc.organization_numer }}<br><br>\r\n                    <strong>Website:</strong> {{ doc.website }}<br><br>\r\n                    <strong>Email:</strong> {{ doc.email }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">2. EMPLOYEE INFORMATION</div>\r\n        <table style=\"width: 100%; border-collapse: collapse;\">\r\n            <tr style=\"margin: 0; padding: 0;\">\r\n                <td style=\"width:50%; padding: 2px 8px; vertical-align: top; line-height: 1;\">\r\n                    <strong>First Name:</strong> {{ doc.first_name }}<br><br>\r\n                    <strong>Middle Name:</strong> {{ doc.middle_name }}<br><br>\r\n                    <strong>Last Name:</strong> {{ doc.last_name }}<br><br>\r\n                    <strong>Address 1:</strong> {{ doc.applicant_address }}<br><br>\r\n                    {% if doc.address2 %}\r\n                    <strong>Address 2:</strong> {{ doc.address2 }}<br><br>\r\n                    {% endif %}\r\n                    <strong>ZIP / Postal Code:</strong> {{ doc.zip__postal_code }}<br><br>\r\n                    <strong>City:</strong> {{ doc.city_emp }}\r\n                </td>\r\n                <td style=\"width:50%; padding: 2px 8px; vertical-align: top; line-height: 1;\">\r\n                    <strong>Date of Birth:</strong> {{ doc.date_of_birth }}<br><br>\r\n                    <strong>Gender:</strong> {{ doc.gender }}<br><br>\r\n                    <strong>Country of Birth:</strong> {{ doc.country_of_birth }}<br><br>\r\n                    <strong>Citizenship:</strong> {{ doc.citizenship }}<br><br>\r\n                    <strong>Contact Number:</strong> {{ doc.applicant_contact_number }}<br><br>\r\n                    <strong>Email:</strong> {{ doc.applicant_email }}<br><br>\r\n                    <strong>State:</strong> {{ doc.state__province }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div> \r\n\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">3. BANK INFORMATION</div>\r\n        <table style=\"width: 100%; border-collapse: collapse;\">\r\n            <tr style=\"margin: 0; padding: 0;\">\r\n                <td style=\"width:50%; padding: 2px 8px; vertical-align: top; line-height: 1;\">\r\n                    <strong>Bank Name:</strong> {{ doc.bank }}<br><br>\r\n                    <strong>BIC Code:</strong> {{ doc.bic_code }}\r\n                </td>\r\n                <td style=\"width:50%; padding: 2px 8px; vertical-align: top; line-height: 1;\">\r\n                    <strong>Account Number:</strong> {{ doc.your_bank_account_number }}<br>\r\n                    {% if doc.bank == \"Other\" %}\r\n                    <br><strong>Other Bank Name:</strong> {{ doc.name_the_other_bank }}\r\n                    {% endif %}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    {% if doc.please_attach_a_picture_your_valid_id_or_passport %}\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">4. ID/Passport</div>\r\n        <img src=\"{{ doc.please_attach_a_picture_your_valid_id_or_passport }}\" class=\"id-image\">\r\n    </div>\r\n    {% endif %}\r\n\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">5. EMPLOYMENT AND WORKPLACE</div>\r\n        <h4>Job Duties</h4>\r\n        <p>According to this agreement, the employee is employed by the company Ljungan Skogsv\u00e5rd AB to perform the following work in forestry:</p>\r\n        <p>The work includes the following:</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li checked\">Forest Clearing</li>\r\n            <li class=\"checkbox-li {% if doc.forest_planting == 1 or doc.forest_planting == '1' %}checked{% endif %}\">Forest Planting</li>\r\n            <li class=\"checkbox-li {% if doc.forest_planning == 1 or doc.forest_planning == '1' %}checked{% endif %}\">Forest Planning</li>\r\n            <li class=\"checkbox-li {% if doc.work_report == 1 or doc.work_report == '1' %}checked{% endif %}\">Work Report</li>\r\n        </ul>\r\n        <p>For this agreement, the provisions agreed with the GS UNION apply, with the additions stated below.</p>\r\n    </div>\r\n\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">6. PLACE OF EMPLOYMENT</div>\r\n        <p>The Company's main workplace is:<h5>Folketshusv\u00e4gen 40, 841 98 LJUNGAVERK, Sweden</h5></p>\r\n        <p>Place of employment rules:</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.the_main_rule == '1' or doc.the_main_rule == 1 %}checked{% endif %}\">\r\n                <strong>The main rule:</strong>\r\n                {% if doc.the_main_rule and doc.the_main_rule != '1' and doc.the_main_rule != 1 %}\r\n                {{ doc.the_main_rule }}\r\n                {% else %}\r\n                The place of employment is the place where the employee performs the main part of his work.\r\n                {% endif %}\r\n            </li>\r\n            <li class=\"checkbox-li {% if doc.the_alternative_rule == '1' or doc.the_alternative_rule == 1 %}checked{% endif %}\">\r\n                <strong>The alternative rule:</strong>\r\n                {% if doc.the_alternative_rule and doc.the_alternative_rule != '1' and doc.the_alternative_rule != 1 %}\r\n                {{ doc.the_alternative_rule }}\r\n                {% else %}\r\n                If the work is performed while moving or at workplaces that are constantly changing, the place of work is instead the place where the employee picks up and leaves work materials or prepares and finishes his work tasks.\r\n                {% endif %}\r\n            </li>\r\n            <li class=\"checkbox-li {% if doc.the_exception_rule == '1' or doc.the_exception_rule == 1 %}checked{% endif %}\">\r\n                <strong>The exception rule:</strong>\r\n                {% if doc.the_exception_rule and doc.the_exception_rule != '1' and doc.the_exception_rule != 1 %}\r\n                {{ doc.the_exception_rule }}\r\n                {% else %}\r\n                If the work takes place for a limited time at each location, which applies to certain works in the building and construction industry and similar industries, the residence is a place of employment.\r\n                {% endif %}\r\n            </li>\r\n        </ul>\r\n    </div>\r\n\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">7. FORM OF EMPLOYMENT</div>\r\n    \r\n        <p><strong>Basis for time limitation:</strong></p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.probationary_employment == 1 or doc.probationary_employment == '1' %}checked{% endif %}\">\r\n                Probationary employment\r\n                {% if doc.probationary_employment_period_in_month %} (Period: {{ doc.probationary_employment_period_in_month }} months){% endif %}\r\n            </li>\r\n            <li class=\"checkbox-li {% if doc.special_fixed_term_employment == 1 or doc.special_fixed_term_employment == '1' %}checked{% endif %}\">Special fixed term employment</li>\r\n            <li class=\"checkbox-li checked\">Seasonal work</li>\r\n        </ul>\r\n    \r\n        {% if doc.estimated_starting_date or doc.estimated_finish_date %}\r\n        <p><strong>Estimated Dates:</strong></p>\r\n        {% if doc.estimated_starting_date %}\r\n            <p>Starting Date: {{ doc.estimated_starting_date }}</p>\r\n        {% endif %}\r\n        {% if doc.estimated_finish_date %}\r\n            <p>Ending Date: {{ doc.estimated_finish_date }}</p>\r\n        {% endif %}\r\n        {% endif %}\r\n        <p>The employment contract comes into force when work on the site begins and finishes when the assigned mission is finished and if the weather conditions no longer allow the continuation of the mission.</p>\r\n    </div>\r\n\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">8. TERMS OF EMPLOYMENT</div>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.collective_agreement_gs_union == '1' or doc.collective_agreement_gs_union == 1 %}checked{% endif %}\">\r\n                Collective agreement: GS UNION\r\n            </li>\r\n        </ul>\r\n    \r\n        <p><strong>Working hours per week and time:</strong> {{ doc.workinghours_per_week_and_time }} hours</p>\r\n        {% set start_time = frappe.utils.get_time(doc.time_span_start) %}\r\n        {% set end_time = frappe.utils.get_time(doc.time_span_end) %}\r\n        <p><strong>Time Span:</strong> From {{ start_time.strftime('%H:%M') }} to {{ end_time.strftime('%H:%M') }}</p>\r\n    \r\n        <h4>Conditions for overtime work or more time work:</h4>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.only_ordered_overtime_or_moretime == '1' or doc.only_ordered_overtime_or_moretime == 1 %}checked{% endif %}\">Only ordered overtime or moretime</li>\r\n            <li class=\"checkbox-li checked\">According to the applicable collective agreement</li>\r\n        </ul>\r\n    \r\n        <h4>Salary Information:</h4>\r\n        <p><strong>Hourly Salary in SEK (gross):</strong> {{ doc.hourly_salary_in_sek_gross_salary }}</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.piecework_pay_according_to_a_separate_agreement == '1' or doc.piecework_pay_according_to_a_separate_agreement == 1 %}checked{% endif %}\">\r\n                Piecework pay according to a separate agreement\r\n            </li>\r\n        </ul>\r\n    \r\n        <h5>Pay period:</h5>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li checked\">Paid the month after earning</li>\r\n            <li class=\"checkbox-li checked\">Paid on the 25th each month</li>\r\n        </ul>\r\n    \r\n        <p>Holiday 13% and ATF (Working Time Shortening) 3.62% are calculated on gross salary and paid with salary</p>\r\n    \r\n        <h5>Holiday right:</h5>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.by_law == '1' or doc.by_law == 1 %}checked{% endif %}\">By law</li>\r\n            <li class=\"checkbox-li checked\">By law and collective agreement</li>\r\n            <li class=\"checkbox-li {% if doc.deviating_regulations_a == '1' or doc.deviating_regulations_a == 1 or not doc.deviating_regulations_a is defined %}checked{% endif %}\">Deviating Regulations</li>\r\n            <p><strong>Number of paid holiday days:</strong> {{ doc.number_of_paid_holiday_days }}</p>\r\n        </ul>\r\n    \r\n        <h5>Training:</h5>\r\n        <li style=\"list-style-type: none;\" class=\"checkbox-li {% if doc.the_employer_provides_adequate_training == '1' or doc.the_employer_provides_adequate_training == 1 %}checked{% endif %}\">\r\n            The employer provides adequate training before the employee starts work in the field.\r\n        </li>\r\n    \r\n        <h5>Insurances:</h5>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.insurance_by_law == '1' or doc.insurance_by_law == 1 %}checked{% endif %}\">By law</li>\r\n            <li class=\"checkbox-li checked\">According to collective agreement</li>\r\n        </ul>\r\n    \r\n        <h5>Termination:</h5>\r\n        <p>Termination of the employment relationship must take place for both parties according to the rules in:</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.the_employment_protection_act == '1' or doc.the_employment_protection_act == 1 %}checked{% endif %}\">The Employment Protection Act</li>\r\n            <li class=\"checkbox-li {% if doc.collective_agreement == '1' or doc.collective_agreement == 1 %}checked{% endif %}\">Collective Agreement</li>\r\n        </ul>\r\n    \r\n        <p>For both parties, notice of termination of employment must be given in writing.</p>\r\n    </div>\r\n\r\n    <div class=\"conduct-section\">\r\n        <div class=\"section-title\">9. CODE OF CONDUCT</div>\r\n        <ul class=\"checkbox-list\">\r\n            {% if doc.language == 'Swedish' %}\r\n            <li class=\"checkbox-li checked\">Swedish</li>\r\n            {% elif doc.language == 'English' %}\r\n            <li class=\"checkbox-li checked\">English</li>\r\n            {% elif doc.language == 'Romanian' %}\r\n            <li class=\"checkbox-li checked\">Romanian</li>\r\n            {% elif doc.language == 'Thai' %}\r\n            <li class=\"checkbox-li checked\">Thai</li>\r\n            {% endif %}\r\n        </ul>\r\n        <p>By signing the Employee Contract below, I certify that I have read and understood the Code of Contact.</p>\r\n    </div>\r\n    \r\n    \r\n    \r\n\r\n    <div class=\"section signature-area\">\r\n    <div class=\"section-title\">10. SIGNATURE</div>\r\n    <p>\r\n        The agreed conditions in the agreement above are hereby confirmed. The employee also confirms that the employer in accordance with the applicable data protection legislation has informed the employee about the employer's processing of employees' personal data.\r\n    </p>\r\n\r\n    <table style=\"width:100%; border:none;\">\r\n        <tr>\r\n            <td style=\"width:50%; border:none; vertical-align: top;\">\r\n                <p><strong>Employee Signature:</strong></p>\r\n\r\n                <!-- Horizontal line up to 'Place' -->\r\n                <div style=\"border-top: 1px solid #333; width: 100%; margin-bottom: 4px;\"></div>\r\n                <p><strong>Place:</strong> {{ doc.place_a }}</p>\r\n                <p><strong>Date:</strong> {{ doc.emp_sign_time }}</p>\r\n                <p><strong>Name:</strong> {{ doc.employee_name }}</p>\r\n                {% if doc.signature_from_employee %}\r\n                 <img src=\"{{ doc.signature_from_employee }}\" alt=\"Employee Signature\" style=\"width: 200px; height: 100px; object-fit: contain; filter: brightness(1) contrast(1);\" />\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td style=\"width:50%; border:none; vertical-align: top;\">\r\n                <p><strong>Employer Signature:</strong></p>\r\n\r\n                <!-- Horizontal line up to 'Place' -->\r\n                <div style=\"border-top: 1px solid #333; width: 100%; margin-bottom: 4px;\"></div>\r\n                <p><strong>Place:</strong> {{ doc.place }}</p>\r\n                <p><strong>Date:</strong> {{ doc.completion_sign_time }}</p>\r\n                <p><strong>Name:</strong> {{ doc.employer_name }}</p>\r\n                {% if doc.signature_from_employer %}\r\n                 <img src=\"{{ doc.signature_from_employer }}\" alt=\"Employer Signature\" style=\"width: 200px; height: 100px; object-fit: contain; filter: brightness(1) contrast(1); margin-left: -10px;\" />\r\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n\r\n\r\n\r\n\r\n    <div class=\"lsn-wrapper\">\r\n        <h1 class=\"lsn-title\">Certificate of Completion</h1>\r\n\r\n        <div class=\"grid-wrapper\">\r\n            <div class=\"lsn-metadata\">\r\n                <div>\r\n                    <div><strong>SIGN REQUEST ISSUED:</strong></div>\r\n                    <div>{{ doc.requested_from_job_offer }} UTC</div>\r\n                </div>\r\n                <div>\r\n                    <div><strong>REQUESTED BY:</strong></div>\r\n                    <div><strong>HR Department</strong><br><strong>hr@ljunganforestry.se</strong></div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"lsn-status\">\r\n                <div><strong>STATUS:</strong></div>\r\n                \u2705 Completed<br>\r\n                on {{ doc.completion_sign_time }} UTC\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"lsn-generated\">\r\n            Generated on {{ doc.completion_sign_time }}\r\n        </div>\r\n\r\n        <div class=\"lsn-trail\">\r\n            <h2>\ud83d\udd52 Audit trail</h2>\r\n\r\n            <div class=\"lsn-event\">\r\n                <div class=\"lsn-time\">{{ doc.requested_from_job_offer }} UTC</div>\r\n                <div><strong>Ove Eriksson</strong> sent invitation to sign the document</div>\r\n                <div><p>ove.eriksson@dahai.se</p> <span class=\"lsn-verified\">\u2714 Verified</span></div>\r\n            </div>\r\n\r\n            <div class=\"lsn-event\">\r\n                <div class=\"lsn-time\">{{ doc.emp_sign_time }} UTC</div>\r\n                <div><strong>{{ doc.first_name }}, {{ doc.last_name }}</strong> signed the document</div>\r\n                <div>{{ doc.applicant_email }} <span class=\"lsn-verified\">\u2714 Verified</span></div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
