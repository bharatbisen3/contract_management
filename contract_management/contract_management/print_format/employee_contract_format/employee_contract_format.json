{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-05-13 13:08:19.342646",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Employee Contract",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n \r\n<html>\r\n \r\n<head>\r\n \r\n    <meta charset=\"utf-8\">\r\n    <title>Employee Contract - {{ doc.name }}</title>\r\n    <style>\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            line-height: 1.6;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        .header {\r\n            text-align: center;\r\n            margin-bottom: 30px;\r\n        }\r\n        .header h1 {\r\n            margin-bottom: 5px;\r\n        }\r\n        .section {\r\n            margin-bottom: 20px;\r\n            page-break-inside: avoid;\r\n        }\r\n        .section-title {\r\n            font-weight: bold;\r\n            border-bottom: 1px solid #000;\r\n            margin-bottom: 10px;\r\n            padding-bottom: 5px;\r\n        }\r\n        .two-column {\r\n            display: flex;\r\n            justify-content: space-between;\r\n        }\r\n        .column {\r\n            width: 48%;\r\n        }\r\n        .signature-area {\r\n            margin-top: 50px;\r\n        }\r\n        .signature-line {\r\n            border-top: 1px solid #000;\r\n            width: 250px;\r\n            margin-top: 40px;\r\n        }\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-bottom: 15px;\r\n        }\r\n        table, th, td {\r\n            border: 1px solid #ddd;\r\n        }\r\n        th, td {\r\n            padding: 8px;\r\n            text-align: left;\r\n        }\r\n \r\n        .checkbox-label {\r\n            display: flex;\r\n            align-items: flex-start;\r\n            margin-bottom: 10px;\r\n        }\r\n \r\n        .checkbox-label input[type=\"checkbox\"] {\r\n            margin-right: 10px;\r\n            width: 18px;\r\n            height: 18px;\r\n            accent-color: #ffffff;\r\n        }\r\n \r\n        ul.rule-list {\r\n            list-style: none;\r\n            padding-left: 0;\r\n        }\r\n \r\n        ul.rule-list li {\r\n            margin-bottom: 10px;\r\n        }\r\n \r\n        .rule-content {\r\n            display: none;\r\n        }\r\n \r\n        .rule-content.active {\r\n            display: inline;\r\n        }\r\n \r\n        /* Checkbox styling with toggle functionality */\r\n        .checkbox-list {\r\n            list-style: none;\r\n            padding-left: 0;\r\n            margin: 0 0 1em 0;\r\n        }\r\n \r\n        .checkbox-li {\r\n            position: relative;\r\n            padding-left: 28px;\r\n            margin-bottom: 8px;\r\n            user-select: none;\r\n        }\r\n \r\n        .checkbox-li::before {\r\n            content: \"\";\r\n            position: absolute;\r\n            left: 0;\r\n            top: 3px;\r\n            width: 18px;\r\n            height: 18px;\r\n            border: 2px solid #007BFF;\r\n            border-radius: 4px;\r\n            background-color: #fff;\r\n            box-sizing: border-box;\r\n        }\r\n \r\n        /* Only show checkmark when the element has the 'checked' class */\r\n        .checkbox-li.checked::after {\r\n            content: \"\u2714\";\r\n            position: absolute;\r\n            left: 3px;\r\n            top: 1px;\r\n            font-size: 16px;\r\n            color: #007BFF;\r\n            font-weight: bold;\r\n            user-select: none;\r\n        }\r\n        \r\n        \r\n    .section {\r\n    display: block !important;\r\n}\r\n\r\n    </style>\r\n    <script>\r\n        document.addEventListener('DOMContentLoaded', function () {\r\n            // Toggle rule text based on checkboxes\r\n            function toggleRule(checkboxId, customId, theoryId) {\r\n                const isChecked = document.getElementById(checkboxId).checked;\r\n                document.getElementById(customId).classList.toggle('active', isChecked);\r\n                document.getElementById(theoryId).classList.toggle('active', !isChecked);\r\n            }\r\n \r\n            // Attach toggle events to checkboxes\r\n            document.getElementById('checkbox-main').addEventListener('change', function () {\r\n                toggleRule('checkbox-main', 'custom-main', 'theory-main');\r\n            });\r\n            document.getElementById('checkbox-alt').addEventListener('change', function () {\r\n                toggleRule('checkbox-alt', 'custom-alt', 'theory-alt');\r\n            });\r\n        });\r\n    </script>\r\n</head>\r\n \r\n<body>\r\n    <div class=\"header\">\r\n        <h1>EMPLOYEE CONTRACT</h1>\r\n        <p>Contract Number: {{ doc.name }}</p>\r\n    </div>\r\n \r\n    <!-- Employer Information -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">1. EMPLOYER INFORMATION</div>\r\n        <div class=\"two-column\">\r\n            <div class=\"column\">\r\n                <p><strong>Employer:</strong> {{ doc.employer }}</p>\r\n                <p><strong>Organization Number:</strong> {{ doc.organization_numer }}</p>\r\n                <p><strong>Website:</strong> {{ doc.website }}</p>\r\n                <p><strong>Email:</strong> {{ doc.email }}</p>\r\n                <p><strong>Mobile Phone:</strong> {{ doc.mobile_phone_number }}</p>\r\n            </div>\r\n            <div class=\"column\">\r\n                <p><strong>Address:</strong> {{ doc.address }}</p>\r\n                <p><strong>Postcode:</strong> {{ doc.postcode }}</p>\r\n                <p><strong>City:</strong> {{ doc.city }}</p>\r\n                <p><strong>Country:</strong> {{ doc.country }}</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n \r\n    <!-- Employee Information -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">2. EMPLOYEE INFORMATION</div>\r\n        <div class=\"two-column\">\r\n            <div class=\"column\">\r\n                <p><strong>First Name:</strong> {{ doc.first_name }}</p>\r\n                <p><strong>Middle Name:</strong> {{ doc.middle_name }}</p>\r\n                <p><strong>Last Name:</strong> {{ doc.last_name }}</p>\r\n                <p><strong>Address 1:</strong> {{ doc.applicant_address }}</p>\r\n                {% if doc.address2 %}\r\n                <p><strong>Address 2:</strong> {{ doc.address2 }}</p>\r\n                {% endif %}\r\n                <p><strong>ZIP / Postal Code:</strong> {{ doc.zip__postal_code }}</p>\r\n                <p><strong>City:</strong> {{ doc.city_emp }}</p>\r\n            </div>\r\n            <div class=\"column\">\r\n                <p><strong>Date of Birth:</strong> {{ doc.date_of_birth }}</p>\r\n                <p><strong>Gender:</strong> {{ doc.gender }}</p>\r\n                <p><strong>Country of Birth:</strong> {{ doc.country_of_birth }}</p>\r\n                <p><strong>Citizenship:</strong> {{ doc.citizenship }}</p>\r\n                <p><strong>Contact Number:</strong> {{ doc.applicant_contact_number }}</p>\r\n                <p><strong>Email:</strong> {{ doc.applicant_email }}</p>\r\n                <p><strong>State:</strong> {{ doc.state__province }}</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n \r\n    <!-- Bank Information -->\r\n    <div class=\"section\">\r\n\r\n        <div class=\"section-title\">3. BANK INFORMATION</div>\r\n        <div class=\"two-column\">\r\n            <div class=\"column\">\r\n                <p><strong>Bank:</strong> {{ doc.bank }}</p>\r\n                {% if doc.bank == \"Other\" %}\r\n                <p><strong>Other Bank Name:</strong> {{ doc.name_the_other_bank }}</p>\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"column\">\r\n                <p><strong>BIC Code:</strong> {{ doc.bic_code }}</p>\r\n                <p><strong>Account Number:</strong> {{ doc.your_bank_account_number }}</p>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"two-column\">\r\n            {% if doc.bank_document_image %}\r\n            <div class=\"column\">\r\n                <p><strong>Bank Document Image:</strong></p>\r\n                <img src=\"{{ doc.bank_document_image }}\" alt=\"Bank Document\"\r\n                    style=\"max-width: 40px; border: 1px solid #ccc;\">\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if doc.please_attach_a_picture_your_valid_id_or_passport %}\r\n            <div class=\"column\">\r\n                <p><strong>Attached ID/Passport:</strong></p>\r\n                <img src=\"{{ doc.please_attach_a_picture_your_valid_id_or_passport }}\"\r\n                    style=\"max-width: 300px; border: 1px solid #ccc; padding: 5px;\">\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n\r\n\r\n \r\n   <!-- Employment and Workplace -->\r\n<div class=\"section\">\r\n    <div class=\"section-title\">4. EMPLOYMENT AND WORKPLACE</div>\r\n    <h4>Job Duties</h4>\r\n    <p>According to this agreement, the employee is employed by the company Ljungan Skogsv\u00e5rd AB to perform the following work in forestry:</p>\r\n    <p>The work includes the following:</p>\r\n    <ul class=\"checkbox-list\">\r\n        {% if doc.forest_clearing %}\r\n        <li class=\"checkbox-li {% if doc.forest_clearing == '1' or doc.forest_clearing == 1 %}checked{% endif %}\">Forest Clearing</li>\r\n        {% endif %}\r\n        {% if doc.forest_planting %}\r\n        <li class=\"checkbox-li {% if doc.forest_planting == '1' or doc.forest_planting == 1 %}checked{% endif %}\">Forest Planting</li>\r\n        {% endif %}\r\n        {% if doc.forest_planning %}\r\n        <li class=\"checkbox-li {% if doc.forest_planning == '1' or doc.forest_planning == 1 %}checked{% endif %}\">Forest Planning</li>\r\n        {% endif %}\r\n        {% if doc.work_report %}\r\n        <li class=\"checkbox-li {% if doc.work_report == '1' or doc.work_report == 1 %}checked{% endif %}\">Work Report</li>\r\n        {% endif %}\r\n    </ul>\r\n    <p>For this agreement, the provisions agreed with the GS UNION apply, with the additions stated below.</p>\r\n</div>\r\n \r\n<!-- Place of Employment -->\r\n<div class=\"section\">\r\n    <div class=\"section-title\">5. PLACE OF EMPLOYMENT</div>\r\n    <p>The Company's main workplace is:</p>\r\n    <p>Place of employment rules:</p>\r\n    <ul class=\"checkbox-list\">\r\n        <li class=\"checkbox-li {% if doc.the_main_rule == '1' or doc.the_main_rule == 1 %}checked{% endif %}\">\r\n            <strong>The main rule:</strong>\r\n            {% if doc.the_main_rule and doc.the_main_rule != '1' and doc.the_main_rule != 1 %}\r\n            {{ doc.the_main_rule }}\r\n            {% else %}\r\n            The place of employment is the place where the employee performs the main part of his work.\r\n            {% endif %}\r\n        </li>\r\n        <li class=\"checkbox-li {% if doc.the_alternative_rule == '1' or doc.the_alternative_rule == 1 %}checked{% endif %}\">\r\n            <strong>The alternative rule:</strong>\r\n            {% if doc.the_alternative_rule and doc.the_alternative_rule != '1' and doc.the_alternative_rule != 1 %}\r\n            {{ doc.the_alternative_rule }}\r\n            {% else %}\r\n            If the work is performed while moving or at workplaces that are constantly changing, the place of work is instead the place where the employee picks up and leaves work materials or prepares and finishes his work tasks.\r\n            {% endif %}\r\n        </li>\r\n        <li class=\"checkbox-li {% if doc.the_exception_rule == '1' or doc.the_exception_rule == 1 %}checked{% endif %}\">\r\n            <strong>The exception rule:</strong>\r\n            {% if doc.the_exception_rule and doc.the_exception_rule != '1' and doc.the_exception_rule != 1 %}\r\n            {{ doc.the_exception_rule }}\r\n            {% else %}\r\n            If the work takes place for a limited time at each location, which applies to certain works in the building and construction industry and similar industries, the residence is a place of employment.\r\n            {% endif %}\r\n        </li>\r\n    </ul>\r\n</div>\r\n \r\n   <!-- Form of Employment -->\r\n<div class=\"section\">\r\n    <div class=\"section-title\">6. FORM OF EMPLOYMENT</div>\r\n \r\n    <p><strong>Basis for time limitation:</strong></p>\r\n    <ul class=\"checkbox-list\">\r\n        {% if doc.probationary_employment %}\r\n        <li class=\"checkbox-li {% if doc.probationary_employment == '1' or doc.probationary_employment == 1 %}checked{% endif %}\">\r\n            Probationary employment\r\n            {% if doc.probationary_employment_period_in_month %} (Period: {{ doc.probationary_employment_period_in_month }} months){% endif %}\r\n        </li>\r\n        {% endif %}\r\n        {% if doc.special_fixed_term_employment %}\r\n        <li class=\"checkbox-li {% if doc.special_fixed_term_employment == '1' or doc.special_fixed_term_employment == 1 %}checked{% endif %}\">Special fixed term employment</li>\r\n        {% endif %}\r\n        {% if doc.seasonal_work %}\r\n        <li class=\"checkbox-li {% if doc.seasonal_work == '1' or doc.seasonal_work == 1 %}checked{% endif %}\">Seasonal work</li>\r\n        {% endif %}\r\n    </ul>\r\n \r\n    {% if doc.estimated_starting_date or doc.estimated_finish_date %}\r\n    <p><strong>Estimated Dates:</strong></p>\r\n    <ul class=\"checkbox-list\">\r\n        {% if doc.estimated_starting_date %}\r\n        <li class=\"checkbox-li checked\">Starting Date: {{ doc.estimated_starting_date }}</li>\r\n        {% endif %}\r\n        {% if doc.estimated_finish_date %}\r\n        <li class=\"checkbox-li checked\">Finish Date: {{ doc.estimated_finish_date }}</li>\r\n        {% endif %}\r\n    </ul>\r\n    {% endif %}\r\n \r\n    <p>The employment contract comes into force when work on the site begins and finishes when the assigned mission is finished and if the weather conditions no longer allow the continuation of the mission.</p>\r\n</div>\r\n \r\n<!-- Terms of Employment -->\r\n<div class=\"section\">\r\n  <div class=\"section-title\">7. TERMS OF EMPLOYMENT</div>\r\n \r\n  <p><strong>Working hours per week:</strong> {{ doc.workinghours_per_week_and_time }} hours</p>\r\n  <p><strong>Time Span:</strong> From {{ doc.time_span_start }} to {{ doc.time_span_end }}</p>\r\n \r\n  <h4>Conditions for overtime/moretime</h4>\r\n  <ul class=\"checkbox-list\">\r\n    <li class=\"checkbox-li {% if doc.only_ordered_overtime_or_moretime == '1' or doc.only_ordered_overtime_or_moretime == 1 %}checked{% endif %}\">Only ordered overtime or moretime</li>\r\n    <li class=\"checkbox-li {% if doc.according_to_the_applicable_collective_agreement == '1' or doc.according_to_the_applicable_collective_agreement == 1 %}checked{% endif %}\">According to the applicable collective agreement</li>\r\n  </ul>\r\n \r\n  <h4>Salary Information</h4>\r\n  <p><strong>Hourly Salary in SEK (gross):</strong> {{ doc.hourly_salary_in_sek_gross_salary }}</p>\r\n  <p>Piecework pay as per separate agreement</p>\r\n \r\n  <h5>Pay period</h5>\r\n  <ul class=\"checkbox-list\">\r\n    <li class=\"checkbox-li {% if doc.paid_the_month_after_earning == '1' or doc.paid_the_month_after_earning == 1 %}checked{% endif %}\">Paid the month after earning</li>\r\n    <li class=\"checkbox-li {% if doc.paid_on_the_25th_each_month == '1' or doc.paid_on_the_25th_each_month == 1 %}checked{% endif %}\">Paid on the 25th each month</li>\r\n  </ul>\r\n \r\n  <p>Holiday 13% and ATF (Working Time Shortening) 3.62% are calculated on gross salary and paid with salary</p>\r\n \r\n  <h5>Holiday right</h5>\r\n  <ul class=\"checkbox-list\">\r\n    <li class=\"checkbox-li {% if doc.by_law == '1' or doc.by_law == 1 %}checked{% endif %}\">By law</li>\r\n    <li class=\"checkbox-li {% if doc.by_law_and_collective_agreement == '1' or doc.by_law_and_collective_agreement == 1 %}checked{% endif %}\">By law and collective agreement</li>\r\n  </ul>\r\n \r\n  <p>Any training provided by the employer</p>\r\n \r\n  <h5>Insurances</h5>\r\n  <ul class=\"checkbox-list\">\r\n    <li class=\"checkbox-li {% if doc.insurance_by_law == '1' or doc.insurance_by_law == 1 %}checked{% endif %}\">By law</li>\r\n    <li class=\"checkbox-li {% if doc.insurance_according_to_collective_agreement == '1' or doc.insurance_according_to_collective_agreement == 1 %}checked{% endif %}\">According to collective agreement</li>\r\n  </ul>\r\n \r\n  <p>Termination of the employment relationship must take place for both parties according to the rules in:</p>\r\n  <ul class=\"checkbox-list\">\r\n    <li class=\"checkbox-li {% if doc.the_employment_protection_act == '1' or doc.the_employment_protection_act == 1 %}checked{% endif %}\">The Employment Protection Act</li>\r\n    <li class=\"checkbox-li {% if doc.collective_agreement == '1' or doc.collective_agreement == 1 %}checked{% endif %}\">Collective Agreement</li>\r\n  </ul>\r\n \r\n  <p>For both parties, notice of termination of employment must be given in writing.</p>\r\n</div>\r\n \r\n \r\n \r\n \r\n   <!-- Signature -->\r\n<div class=\"section signature-area\">\r\n    <h4>Signatures</h4>\r\n    <p>\r\n        The agreed conditions in the agreement above are hereby confirmed. The employee also confirms that the employer in accordance with the applicable data protection legislation has informed the employee about the employer's processing of employees' personal data.\r\n    </p>\r\n    <div class=\"two-column\">\r\n        <div class=\"column\">\r\n            <p><strong>Employer Signature:</strong></p>\r\n            {% if doc.signature_from_employee %}\r\n                <img src=\"{{ doc.signature_from_employee }}\" alt=\"Employer Signature\" style=\"max-width: 200px; max-height: 100px;\" />\r\n            {% endif %}\r\n            <p><strong>Date:</strong> {{ doc.date_a }}</p>\r\n            <p><strong>Place:</strong> {{ doc.place_a }}</p>\r\n        </div>\r\n        <div class=\"column\">\r\n            <p><strong>Employee Signature:</strong></p>\r\n            {% if doc.signature_from_employer %}\r\n                <img src=\"{{ doc.signature_from_employer }}\" alt=\"Employee Signature\" style=\"max-width: 200px; max-height: 100px;\" />\r\n            {% endif %}\r\n            <p><strong>Date:</strong> {{ doc.date }}</p>\r\n            <p><strong>Place:</strong> {{ doc.place }}</p>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n</body>\r\n</html>\r\n\r\n\r\n\r\n",
 "idx": 0,
 "line_breaks": 0,
