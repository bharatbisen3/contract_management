 "html": "<h3 style=\"text-align:center;\">\r\n    Payroll Slip April 2025 Work Team Member 1 (Team Leader)\r\n</h3>\r\n\r\n<table class=\"table table-bordered\" style=\"width:100%; font-size: 12px;\">\r\n    <thead>\r\n        <tr>\r\n            <th>Salary Type</th>\r\n            <th>Description</th>\r\n            <th>From Date</th>\r\n            <th>To Date</th>\r\n            <th>Number</th>\r\n            <th>Rate SEK</th>\r\n            <th>Total Amount</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for row in doc.earnings_table %}\r\n        <tr>\r\n            <td>{{ row.salary_type }}</td>\r\n            <td>{{ row.description }}</td>\r\n            <td>{{ row.from_date }}</td>\r\n            <td>{{ row.to_date }}</td>\r\n            <td>{{ row.number_of_units }}</td>\r\n            <td style=\"text-align:right;\">{{ row.rate_sek }}</td>\r\n            <td style=\"text-align:right; font-weight: bold;\">{{ row.total_amount }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n<table class=\"table\" style=\"width:40%; float:right; font-size: 14px; margin-top: 24px;\">\r\n    <tbody>\r\n        <tr>\r\n            <td style=\"font-weight: bold; text-align:right;\">Gross Salary</td>\r\n            <td style=\"text-align:right;\">{{ doc.gross_salary }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-weight: bold; text-align:right;\">Tax</td>\r\n            <td style=\"text-align:right;\">{{ doc.tax }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-weight: bold; text-align:right;\">Tax Free Comp.</td>\r\n            <td style=\"text-align:right;\">{{ doc.tax_free_compensation }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-weight: bold; text-align:right;\">Payment</td>\r\n            <td style=\"text-align:right; font-weight: bold;\">\r\n                {{ doc.payment }}\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n",
