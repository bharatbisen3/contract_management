{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-05-13 13:08:19.342646",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 1,
 "doc_type": "Employee Contract",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"utf-8\">\r\n    <title>Employee Contract - {{ doc.name }}</title>\r\n    <style>\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            line-height: 1.6;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        .header {\r\n            text-align: center;\r\n            margin-bottom: 30px;\r\n        }\r\n        .header h1 {\r\n            margin-bottom: 5px;\r\n        }\r\n        .section {\r\n            margin-bottom: 20px;\r\n            page-break-inside: avoid;\r\n        }\r\n        .section-title {\r\n            font-weight: bold;\r\n            border-bottom: 1px solid #000;\r\n            margin-bottom: 10px;\r\n            padding-bottom: 5px;\r\n        }\r\n        .compact-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        .section table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        .section table td {\r\n            padding: 5px 8px;\r\n            vertical-align: top;\r\n            line-height: 1.3;\r\n        }\r\n        .signature-area {\r\n            margin-top: 50px;\r\n        }\r\n        .signature-line {\r\n            border-top: 1px solid #000;\r\n            width: 250px;\r\n            margin-top: 40px;\r\n        }\r\n        .checkbox-list {\r\n            list-style: none;\r\n            padding-left: 0;\r\n            margin: 0 0 1em 0;\r\n        }\r\n        .checkbox-li {\r\n            position: relative;\r\n            padding-left: 28px;\r\n            margin-bottom: 8px;\r\n            user-select: none;\r\n        }\r\n        .checkbox-li::before {\r\n            content: \"\";\r\n            position: absolute;\r\n            left: 0;\r\n            top: 3px;\r\n            width: 18px;\r\n            height: 18px;\r\n            border: 2px solid #007BFF;\r\n            border-radius: 4px;\r\n            background-color: #fff;\r\n            box-sizing: border-box;\r\n        }\r\n        .checkbox-li.checked::after {\r\n            content: \"\u2713\";\r\n            position: absolute;\r\n            left: 3px;\r\n            top: 1px;\r\n            font-size: 16px;\r\n            color: #007BFF;\r\n            font-weight: bold;\r\n            user-select: none;\r\n        }\r\n        .id-image {\r\n            max-width: 300px;\r\n            border: 1px solid #ccc;\r\n            padding: 5px;\r\n            margin-top: 5px;\r\n        }\r\n        @media print {\r\n            body {\r\n                padding: 0;\r\n            }\r\n            .section {\r\n                page-break-inside: avoid;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"header\">\r\n        <h1>EMPLOYEE CONTRACT</h1>\r\n        <p>Contract Number: {{ doc.name }}</p>\r\n    </div>\r\n\r\n    <!-- Employer Information -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">1. EMPLOYER INFORMATION</div>\r\n        <table class=\"compact-table\">\r\n            <tr>\r\n                <td style=\"width:50%\">\r\n                    <strong>Employer:</strong> {{ doc.employer or '' }}<br><br>\r\n                    <strong>Address:</strong> {{ doc.address or '' }}<br><br>\r\n                    <strong>Postcode:</strong> {{ doc.postcode or '' }}<br><br>\r\n                    <strong>City:</strong> {{ doc.city or '' }}<br><br>\r\n                    <strong>Country:</strong> {{ doc.country or '' }}<br><br>\r\n                </td>\r\n                <td style=\"width:50%\">\r\n                    <strong>Mobile Phone:</strong> {{ doc.mobile_phone_number or '' }}<br><br>\r\n                    <strong>Organization Number:</strong> {{ doc.organization_numer or '' }}<br><br>\r\n                    <strong>Website:</strong> {{ doc.website or '' }}<br><br>\r\n                    <strong>Email:</strong> {{ doc.email or '' }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Employee Information -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">2. EMPLOYEE INFORMATION</div>\r\n        <table class=\"compact-table\">\r\n            <tr>\r\n                <td style=\"width:50%\">\r\n                    <strong>First Name:</strong> {{ doc.first_name or '' }}<br><br>\r\n                    <strong>Middle Name:</strong> {{ doc.middle_name or '' }}<br><br>\r\n                    <strong>Last Name:</strong> {{ doc.last_name or '' }}<br><br>\r\n                    <strong>Address 1:</strong> {{ doc.applicant_address or '' }}<br><br>\r\n                    {% if doc.address2 %}\r\n                    <strong>Address 2:</strong> {{ doc.address2 }}<br><br>\r\n                    {% endif %}\r\n                    <strong>ZIP / Postal Code:</strong> {{ doc.zip__postal_code or '' }}<br><br>\r\n                    <strong>City:</strong> {{ doc.city_emp or '' }}\r\n                </td>\r\n                <td style=\"width:50%\">\r\n                    <strong>Date of Birth:</strong> {{ doc.date_of_birth or '' }}<br><br>\r\n                    <strong>Gender:</strong> {{ doc.gender or '' }}<br><br>\r\n                    <strong>Country of Birth:</strong> {{ doc.country_of_birth or '' }}<br><br>\r\n                    <strong>Citizenship:</strong> {{ doc.citizenship or '' }}<br><br>\r\n                    <strong>Contact Number:</strong> {{ doc.applicant_contact_number or '' }}<br><br>\r\n                    <strong>Email:</strong> {{ doc.applicant_email or '' }}<br><br>\r\n                    <strong>State:</strong> {{ doc.state__province or '' }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Bank Information -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">3. BANK INFORMATION</div>\r\n        <table class=\"compact-table\">\r\n            <tr>\r\n                <td style=\"width:50%\">\r\n                    <strong>Bank Name:</strong> {{ doc.bank or '' }}<br><br>\r\n                    <strong>BIC Code:</strong> {{ doc.bic_code or '' }}\r\n                </td>\r\n                <td style=\"width:50%\">\r\n                    <strong>Account Number:</strong> {{ doc.your_bank_account_number or '' }}<br><br>\r\n                    {% if doc.bank == \"Other\" %}\r\n                    <strong>Other Bank Name:</strong> {{ doc.name_the_other_bank or '' }}\r\n                    {% endif %}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ID/Passport -->\r\n    {% if doc.please_attach_a_picture_your_valid_id_or_passport %}\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">4. ID/Passport</div>\r\n        <img src=\"{{ doc.please_attach_a_picture_your_valid_id_or_passport }}\" class=\"id-image\" alt=\"Employee ID/Passport\">\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Employment and Workplace -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">5. EMPLOYMENT AND WORKPLACE</div>\r\n        <h4>Job Duties</h4>\r\n        <p>According to this agreement, the employee is employed by the company Ljungan Skogsv\u00e5rd AB to perform the following work in forestry:</p>\r\n        <p>The work includes the following:</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.forest_clearing == 1 or doc.forest_clearing == '1' %}checked{% endif %}\">Forest Clearing</li>\r\n            <li class=\"checkbox-li {% if doc.forest_planting == 1 or doc.forest_planting == '1' %}checked{% endif %}\">Forest Planting</li>\r\n            <li class=\"checkbox-li {% if doc.forest_planning == 1 or doc.forest_planning == '1' %}checked{% endif %}\">Forest Planning</li>\r\n            <li class=\"checkbox-li {% if doc.work_report == 1 or doc.work_report == '1' %}checked{% endif %}\">Work Report</li>\r\n        </ul>\r\n        <p>For this agreement, the provisions agreed with the GS UNION apply, with the additions stated below.</p>\r\n    </div>\r\n\r\n    <!-- Place of Employment -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">6. PLACE OF EMPLOYMENT</div>\r\n        <p>The Company's main workplace is: <strong>Folketshusv\u00e4gen 40, 841 98 LJUNGAVERK, Sweden</strong></p>\r\n        <p>Place of employment rules:</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.the_main_rule == 1 or doc.the_main_rule == '1' %}checked{% endif %}\">\r\n                <strong>The main rule:</strong> The place of employment is the place where the employee performs the main part of his work.\r\n            </li>\r\n            <li class=\"checkbox-li {% if doc.the_alternative_rule == 1 or doc.the_alternative_rule == '1' %}checked{% endif %}\">\r\n                <strong>The alternative rule:</strong> If the work is performed while moving or at workplaces that are constantly changing, the place of work is instead the place where the employee picks up and leaves work materials or prepares and finishes his work tasks.\r\n            </li>\r\n            <li class=\"checkbox-li {% if doc.the_exception_rule == 1 or doc.the_exception_rule == '1' %}checked{% endif %}\">\r\n                <strong>The exception rule:</strong> If the work takes place for a limited time at each location, which applies to certain works in the building and construction industry and similar industries, the residence is a place of employment.\r\n            </li>\r\n        </ul>\r\n    </div>\r\n\r\n    <!-- Form of Employment -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">7. FORM OF EMPLOYMENT</div>\r\n        <p><strong>Basis for time limitation:</strong></p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.probationary_employment == 1 or doc.probationary_employment == '1' %}checked{% endif %}\">\r\n                Probationary employment\r\n                {% if doc.probationary_employment_period_in_month %} (Period: {{ doc.probationary_employment_period_in_month }} months){% endif %}\r\n            </li>\r\n            <li class=\"checkbox-li {% if doc.special_fixed_term_employment == 1 or doc.special_fixed_term_employment == '1' %}checked{% endif %}\">Special fixed term employment</li>\r\n            <li class=\"checkbox-li {% if doc.seasonal_work == 1 or doc.seasonal_work == '1' %}checked{% endif %}\">Seasonal work</li>\r\n        </ul>\r\n        \r\n        {% if doc.estimated_starting_date or doc.estimated_finish_date %}\r\n        <p><strong>Estimated Dates:</strong></p>\r\n        {% if doc.estimated_starting_date %}\r\n            <p>Starting Date: {{ doc.estimated_starting_date }}</p>\r\n        {% endif %}\r\n        {% if doc.estimated_finish_date %}\r\n            <p>Ending Date: {{ doc.estimated_finish_date }}</p>\r\n        {% endif %}\r\n        {% endif %}\r\n        \r\n        <p>The employment contract comes into force when work on the site begins and finishes when the assigned mission is finished and if the weather conditions no longer allow the continuation of the mission.</p>\r\n    </div>\r\n\r\n    <!-- Terms of Employment -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">8. TERMS OF EMPLOYMENT</div>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.collective_agreement_gs_union == 1 or doc.collective_agreement_gs_union == '1' %}checked{% endif %}\">\r\n                Collective agreement: GS UNION\r\n            </li>\r\n        </ul>\r\n        \r\n        <p><strong>Working hours per week and time:</strong> {{ doc.workinghours_per_week_and_time or '' }} hours</p>\r\n        {% if doc.time_span_start and doc.time_span_end %}\r\n        <p><strong>Time Span:</strong> From {{ doc.time_span_start }} to {{ doc.time_span_end }}</p>\r\n        {% endif %}\r\n    \r\n        <h4>Conditions for overtime work or more time work:</h4>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.only_ordered_overtime_or_moretime == 1 or doc.only_ordered_overtime_or_moretime == '1' %}checked{% endif %}\">Only ordered overtime or moretime</li>\r\n            <li class=\"checkbox-li {% if doc.according_to_the_applicable_collective_agreement == 1 or doc.according_to_the_applicable_collective_agreement == '1' %}checked{% endif %}\">According to the applicable collective agreement</li>\r\n        </ul>\r\n    \r\n        <h4>Salary Information:</h4>\r\n        <p><strong>Hourly Salary in SEK (gross):</strong> {{ doc.hourly_salary_in_sek_gross_salary or '' }}</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.piecework_pay_according_to_a_separate_agreement == 1 or doc.piecework_pay_according_to_a_separate_agreement == '1' %}checked{% endif %}\">\r\n                Piecework pay according to a separate agreement\r\n            </li>\r\n        </ul>\r\n        \r\n        <h5>Pay period:</h5>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.the_salary_is_paid_the_month_after_earning == 1 or doc.the_salary_is_paid_the_month_after_earning == '1' %}checked{% endif %}\">Paid the month after earning</li>\r\n            <li class=\"checkbox-li {% if doc.the_salary_is_paid_on_the_25th_of_each_month == 1 or doc.the_salary_is_paid_on_the_25th_of_each_month == '1' %}checked{% endif %}\">Paid on the 25th each month</li>\r\n        </ul>\r\n    \r\n        <p>Holiday 13% and ATF (Working Time Shortening) 3.62% are calculated on gross salary and paid with salary</p>\r\n    \r\n        <h5>Holiday right:</h5>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.by_law == 1 or doc.by_law == '1' %}checked{% endif %}\">By law</li>\r\n            <li class=\"checkbox-li {% if doc.according_to_collective_agreement_and_law == 1 or doc.according_to_collective_agreement_and_law == '1' %}checked{% endif %}\">By law and collective agreement</li>\r\n            <li class=\"checkbox-li {% if doc.deviating_regulations_a == 1 or doc.deviating_regulations_a == '1' %}checked{% endif %}\">Deviating Regulations</li>\r\n        </ul>\r\n        {% if doc.number_of_paid_holiday_days %}\r\n        <p><strong>Number of paid holiday days:</strong> {{ doc.number_of_paid_holiday_days }}</p>\r\n        {% endif %}\r\n        \r\n        <h5>Training:</h5>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.the_employer_provides_adequate_training == 1 or doc.the_employer_provides_adequate_training == '1' %}checked{% endif %}\">\r\n                The employer provides adequate training before the employee starts work in the field.\r\n            </li>\r\n        </ul>\r\n    \r\n        <h5>Insurances:</h5>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.by_law_emp == 1 or doc.by_law_emp == '1' %}checked{% endif %}\">By law</li>\r\n            <li class=\"checkbox-li {% if doc.according_to_collective_agreement_and_law_emp == 1 or doc.according_to_collective_agreement_and_law_emp == '1' %}checked{% endif %}\">According to collective agreement</li>\r\n        </ul>\r\n        \r\n        <h5>Termination:</h5>\r\n        <p>Termination of the employment relationship must take place for both parties according to the rules in:</p>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.the_employment_protection_act == 1 or doc.the_employment_protection_act == '1' %}checked{% endif %}\">The Employment Protection Act</li>\r\n            <li class=\"checkbox-li {% if doc.collective_agreement == 1 or doc.collective_agreement == '1' %}checked{% endif %}\">Collective Agreement</li>\r\n        </ul>\r\n    \r\n        <p>For both parties, notice of termination of employment must be given in writing.</p>\r\n    </div>\r\n\r\n    <!-- Code of Conduct -->\r\n    <div class=\"section\">\r\n        <div class=\"section-title\">9. CODE OF CONDUCT</div>\r\n        <ul class=\"checkbox-list\">\r\n            <li class=\"checkbox-li {% if doc.language %}checked{% endif %}\">\r\n                Language: {{ doc.language or '' }}\r\n            </li>\r\n        </ul>\r\n        <p>By signing the Employee Contract below, I certify that I have read and understood the Code of Contact.</p>\r\n    </div>\r\n\r\n    <!-- Signature -->\r\n    <div class=\"section signature-area\">\r\n        <div class=\"section-title\">10. SIGNATURE</div>\r\n        <p>\r\n            The agreed conditions in the agreement above are hereby confirmed. The employee also confirms that the employer in accordance with the applicable data protection legislation has informed the employee about the employer's processing of employees' personal data.\r\n        </p>\r\n        <table style=\"width:100%; border: none;\">\r\n            <tr>\r\n                <td style=\"width:50%; border: none;\">\r\n                    <p><strong>Employer Signature:</strong></p>\r\n                    <div style=\"display: flex; justify-content: space-between; width: 100%;\">\r\n                        <span><strong>Place:</strong> {{ doc.place_a or '' }}</span>\r\n                        <span><strong>Date:</strong> {{ doc.date_a or '' }}</span>\r\n                    </div>\r\n                    {% if doc.signature_from_employer %}\r\n                        <img src=\"{{ doc.signature_from_employer }}\" alt=\"Employer Signature\" style=\"max-width: 200px; max-height: 100px;\" />\r\n                    {% endif %}\r\n                </td>\r\n                <td style=\"width:50%; border: none;\">\r\n                    <p><strong>Employee Signature:</strong></p>\r\n                    <div style=\"display: flex; justify-content: space-between; width: 100%;\">\r\n                        <span><strong>Place:</strong> {{ doc.place or '' }}</span>\r\n                        <span><strong>Date:</strong> {{ doc.date or '' }}</span>\r\n                    </div>\r\n                    {% if doc.signature_from_employee %}\r\n                        <img src=\"{{ doc.signature_from_employee }}\" alt=\"Employee Signature\" style=\"max-width: 200px; max-height: 100px;\" />\r\n                    {% endif %}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</body>\r\n</html>",
