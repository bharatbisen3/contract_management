 "client_script": "frappe.web_form.after_load = () => {\r\n      addPdfDisplay();\r\n\r\n    // Listen for changes in the \"bank\" dropdown field\r\n    frappe.web_form.on(\"bank\", (field, value) => {\r\n        if (value === \"Other\") {\r\n            frappe.web_form.set_df_property(\"name_the_other_bank\", \"hidden\", 0);  // Show field\r\n        } else {\r\n            frappe.web_form.set_df_property(\"name_the_other_bank\", \"hidden\", 1);  // Hide field\r\n        }\r\n    });\r\n\r\n    // Function to toggle Submit Button and other fields\r\n    function toggleSubmitButton() {\r\n        if (frappe.web_form.get_value(\"terms_and_conditions\") == 1) {\r\n            $(\".submit-btn\").show();  // Show submit button\r\n            frappe.web_form.set_df_property(\"section_break_rnda\", \"hidden\", 0);  \r\n            frappe.web_form.set_df_property(\"signature_of_emp_section\", \"hidden\", 0);\r\n        } else {\r\n            $(\".submit-btn\").hide();  // Hide submit button\r\n            frappe.web_form.set_df_property(\"section_break_rnda\", \"hidden\", 1);  \r\n            frappe.web_form.set_df_property(\"signature_of_emp_section\", \"hidden\", 1);\r\n        }\r\n    }\r\n\r\n    // Run on load to check initial state\r\n    toggleSubmitButton();\r\n\r\n    // Run every time the checkbox value changes\r\n    frappe.web_form.on(\"terms_and_conditions\", toggleSubmitButton);\r\n};\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nfunction addPdfDisplay() {\r\n  // Get the terms checkbox element\r\n  const termsField = $('[data-fieldname=\"terms_and_conditions\"]').closest('.form-group');\r\n  \r\n  // Create PDF display container\r\n  const pdfContainer = $(`\r\n      <div class=\"form-group\">\r\n          <label class=\"control-label\">Important Documents</label>\r\n          <div class=\"pdf-display-container\" style=\"margin: 15px 0;\">\r\n\r\n          <div class=\"pdf-item\" style=\"margin-bottom: 10px;\">\r\n          <a href=\"/files/Code of Condact ENG Occupational Health and Safety Standards and Internal Regulations.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n              <i class=\"fa fa-file-pdf-o\"></i> English\r\n          </a>\r\n      </div>\r\n      \r\n      <div class=\"pdf-item\" style=\"margin-bottom: 10px;\">\r\n          <a href=\"/files/Code of Condact SWE Arbetsskydd normer och interna ordningsregler.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n              <i class=\"fa fa-file-pdf-o\"></i> Swedish\r\n          </a>\r\n      </div>\r\n      \r\n      <div class=\"pdf-item\" style=\"margin-bottom: 10px;\">\r\n          <a href=\"/files/Code of Condact RUM Norme de protect\u0326ie a muncii V1.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n              <i class=\"fa fa-file-pdf-o\"></i> Romanian\r\n          </a>\r\n      </div>\r\n\r\n      <div class=\"pdf-item\" style=\"margin-bottom: 10px;\">\r\n          <a href=\"/files/Code of Condact THAI \u0e19\u0e35\u0e48\u0e04\u0e37\u0e2d\u0e01\u0e32\u0e23\u0e41\u0e1b\u0e25\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e17\u0e35\u0e48\u0e43\u0e2b\u0e49\u0e21\u0e32\u0e40\u0e1b\u0e47\u0e19\u0e20\u0e32\u0e29\u0e32\u0e44\u0e17\u0e22.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n              <i class=\"fa fa-file-pdf-o\"></i> Thai\r\n          </a>\r\n      </div>\r\n\r\n\r\n\r\n          </div>\r\n          <p class=\"help-box small text-muted\">Please review these documents before accepting the terms.</p>\r\n      </div>\r\n  `);\r\n  \r\n  // Insert above the terms checkbox\r\n  pdfContainer.insertBefore(termsField);\r\n  \r\n  // Optional: Add some styling\r\n  $('<style>')\r\n      .text('.pdf-display-container { border-top: 1px solid #eee; padding-top: 15px; }')\r\n      .text('.pdf-item a { display: inline-block; padding: 5px 10px; }')\r\n      .appendTo('head');\r\n}",
