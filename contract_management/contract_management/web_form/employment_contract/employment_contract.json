s-group`).hide(); // Hide the entire section\r\n//     }\r\n// }\r\n\r\n// function toggleTermsCheckbox(language) {\r\n//     const checkboxGroup = $('[data-fieldname=\"terms_and_conditions\"]').closest('.form-group');\r\n//     if (language) {\r\n//         checkboxGroup.show();\r\n//     } else {\r\n//         checkboxGroup.hide();\r\n//     }\r\n// }\r\n\r\n// function toggleSubmitButton() {\r\n//     const termsAccepted = frappe.web_form.get_value(\"terms_and_conditions\") == 1;\r\n//     $(\".submit-btn\").toggle(termsAccepted);\r\n//     frappe.web_form.set_df_property(\"section_break_rnda\", \"hidden\", termsAccepted ? 0 : 1);\r\n//     frappe.web_form.set_df_property(\"signature_of_emp_section\", \"hidden\", termsAccepted ? 0 : 1);\r\n// }\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nfrappe.web_form.after_load = () => {\r\n    addPdfDisplay();\r\n\r\n    // Set initial visibility based on current value\r\n    const initialLanguage = frappe.web_form.get_value(\"language\");\r\n    togglePdfButtons(initialLanguage);\r\n    toggleTermsCheckbox(initialLanguage);\r\n\r\n    // Handle language field changes\r\n    frappe.web_form.on(\"language\", (field, value) => {\r\n        togglePdfButtons(value);\r\n        toggleTermsCheckbox(value);\r\n    });\r\n\r\n    // Handle checkbox toggle for Submit Button\r\n    frappe.web_form.on(\"terms_and_conditions\", toggleSubmitButton);\r\n    toggleSubmitButton();\r\n\r\n    // Show/hide other bank field\r\n    frappe.web_form.on(\"bank\", (field, value) => {\r\n        frappe.web_form.set_df_property(\"name_the_other_bank\", \"hidden\", value !== \"Other\" ? 1 : 0);\r\n    });\r\n\r\n    // NEW: Set emp_sign_time when employee signs\r\n    frappe.web_form.on(\"signature_from_employee\", (field, value) => {\r\n        if (value && !frappe.web_form.get_value(\"emp_sign_time\")) {\r\n            // frappe.web_form.set_value(\"emp_sign_time\", frappe.datetime.now_datetime());\r\n            const utcTimestamp = new Date().toISOString().slice(0, 19).replace('T', ' ');\r\n            frappe.web_form.set_value(\"emp_sign_time\", utcTimestamp);\r\n        }\r\n    });\r\n    \r\n    // NEW: Make fields read-only\r\n    frappe.web_form.set_df_property(\"country_of_birth\", \"read_only\", 1);\r\n    frappe.web_form.set_df_property(\"gender\", \"read_only\", 1);\r\n    frappe.web_form.set_df_property(\"country_emp\", \"read_only\", 1);\r\n    \r\n    // If you need to make them appear disabled visually as well\r\n    // $('[data-fieldname=\"country_of_birth\"] input').attr('disabled', 'disabled');\r\n    // $('[data-fieldname=\"gender\"] select').attr('disabled', 'disabled');\r\n    // $('[data-fieldname=\"country_emp\"] input').attr('disabled', 'disabled');\r\n};\r\n\r\nfunction addPdfDisplay() {\r\n    const termsField = $('[data-fieldname=\"terms_and_conditions\"]').closest('.form-group');\r\n\r\n    const pdfContainer = $(`\r\n        <div class=\"form-group\" id=\"pdf-documents-group\" style=\"display: none;\">\r\n            <label class=\"control-label\">Important Documents</label>\r\n            <div class=\"pdf-display-container\" style=\"margin: 15px 0;\">\r\n                <div class=\"pdf-item pdf-English\" style=\"margin-bottom: 10px; display: none;\">\r\n                    <a href=\"/files/Code of Condact ENG Occupational Health and Safety Standards and Internal Regulations.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n                        <i class=\"fa fa-file-pdf-o\"></i> English\r\n                    </a>\r\n                </div>\r\n                <div class=\"pdf-item pdf-Swedish\" style=\"margin-bottom: 10px; display: none;\">\r\n                    <a href=\"/files/Code of Condact SWE Arbetsskydd normer och interna ordningsregler.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n                        <i class=\"fa fa-file-pdf-o\"></i> Swedish\r\n                    </a>\r\n                </div>\r\n                <div class=\"pdf-item pdf-Romanian\" style=\"margin-bottom: 10px; display: none;\">\r\n                    <a href=\"/files/Code of Condact RUM Norme de protect\u0326ie a muncii V1.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n                        <i class=\"fa fa-file-pdf-o\"></i> Romanian\r\n                    </a>\r\n                </div>\r\n                <div class=\"pdf-item pdf-Thai\" style=\"margin-bottom: 10px; display: none;\">\r\n                    <a href=\"/files/Code of Condact THAI \u0e19\u0e35\u0e48\u0e04\u0e37\u0e2d\u0e01\u0e32\u0e23\u0e41\u0e1b\u0e25\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e17\u0e35\u0e48\u0e43\u0e2b\u0e49\u0e21\u0e32\u0e40\u0e1b\u0e47\u0e19\u0e20\u0e32\u0e29\u0e32\u0e44\u0e17\u0e22.pdf\" target=\"_blank\" class=\"btn btn-default btn-sm\">\r\n                        <i class=\"fa fa-file-pdf-o\"></i> Thai\r\n                    </a>\r\n                </div>\r\n            </div>\r\n            <p class=\"help-box small text-muted\">Please review these documents before accepting the terms.</p>\r\n        </div>\r\n    `);\r\n\r\n    pdfContainer.insertBefore(termsField);\r\n\r\n    $('<style>')\r\n        .text(`\r\n            .pdf-display-container { border-top: 1px solid #eee; padding-top: 15px; }\r\n            .pdf-item a { display: inline-block; padding: 5px 10px; }\r\n        `)\r\n        .appendTo('head');\r\n}\r\n\r\nfunction togglePdfButtons(language) {\r\n    $('.pdf-item').hide(); // Hide all buttons\r\n\r\n    if (language) {\r\n        $(`#pdf-documents-group`).show(); // Show the container\r\n        $(`.pdf-${language}`).show(); // Show only matching button\r\n    } else {\r\n        $(`#pdf-documents-group`).hide(); // Hide the entire section\r\n    }\r\n}\r\n\r\nfunction toggleTermsCheckbox(language) {\r\n    const checkboxGroup = $('[data-fieldname=\"terms_and_conditions\"]').closest('.form-group');\r\n    if (language) {\r\n        checkboxGroup.show();\r\n    } else {\r\n        checkboxGroup.hide();\r\n    }\r\n}\r\n\r\nfunction toggleSubmitButton() {\r\n    const termsAccepted = frappe.web_form.get_value(\"terms_and_conditions\") == 1;\r\n    $(\".submit-btn\").toggle(termsAccepted);\r\n    frappe.web_form.set_df_property(\"section_break_rnda\", \"hidden\", termsAccepted ? 0 : 1);\r\n    frappe.web_form.set_df_property(\"signature_of_emp_section\", \"hidden\", termsAccepted ? 0 : 1);\r\n}\r\n",
