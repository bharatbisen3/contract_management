frappe.ui.form.on("Time And Daily Allowance", {
    after_save: function (frm) {
        frappe.msgprint(`🔎 Triggered for ${frm.doc.name}`);

        frappe.call({
            method: "frappe.client.get",
            args: {
                doctype: "Time And Daily Allowance",
                name: frm.doc.name
            },
            callback: function (r) {
                if (r.message) {
                    let doc = r.message;
                    frappe.msgprint(`📄 Document fetched successfully: ${doc.name}`);

                    (doc.allowance_details || []).forEach(row => {
                        frappe.msgprint(`Row data -> Employee: ${row.employee_id}, Date: ${row.date}, Present: ${row.present}`);

                        if (["Yes", "No"].includes(row.present)) {
                            frappe.call({
                                method: "frappe.client.get_list",
                                args: {
                                    doctype: "Marked Attandance",
                                    filters: {
                                        employee: row.employee_id,
                                        date: row.date
                                    },
                                    limit_page_length: 1
                                },
                                callback: function (res) {
                                    if (res.message.length === 0) {
                                        frappe.msgprint(`✅ Creating new entry for ${row.employee_id}`);

                                        frappe.call({
                                            method: "frappe.client.insert",
                                            args: {
                                                doc: {
                                                    doctype: "Marked Attandance",
                                                    employee: row.employee_id,
                                                    date: row.date,
                                                    duration: row.duration,
                                                    present: row.present,
                                                    allowance: row.allowance,
                                                    project: doc.project__client,
                                                    object: doc.object
                                                }
                                            },
                                            callback: function (insert_res) {
                                                frappe.msgprint(`✅ Inserted Marked Attendance for: ${row.employee_id}`);
                                            }
                                        });
                                    } else {
                                        frappe.msgprint(`⚠️ Entry already exists for ${row.employee_id} on ${row.date}`);
                                    }
                                }
                            });
                        }
                    });
                }
            }
        });
    }
});